# Copy to .env (git-ignored) and fill in. Load with: set -a; . ./.env; set +a
HTTP_ADDR=:8080
DATABASE_URL=postgres://pos:pos@localhost:5433/pos?sslmode=disable
TEST_DATABASE_URL=postgres://pos:pos@localhost:5433/pos_test?sslmode=disable

# Networks to enable, comma-separated (default: sepolia). A checkout can be paid
# on any of them; the first is the default when the customer names no chain. Known: sepolia, base-sepolia, amoy. USDC address, EIP-712 name/version
# and decimals come from the built-in registry (internal/chain/registry.go) and
# are checked on-chain at startup.
CHAINS=sepolia
SEPOLIA_RPC_URL=https://YOUR-SEPOLIA-RPC
# Per network: <NAME>_RPC_URL (required when listed) and <NAME>_CONFIRMATIONS
# (optional; registry default). Sepolia's confirmations use CONFIRMATIONS below.
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# AMOY_CONFIRMATIONS=3

# Optional, from the single-chain setup. If set, each must match the registry's
# Sepolia entry or startup fails.
# CHAIN_ID=11155111
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# USDC_EIP712_NAME=USDC
# USDC_EIP712_VERSION=2

# The fixed merchant that receives every payment.
MERCHANT_ADDRESS=0x3CC845A0014aFcB0D52F673E0a98039074F1474c
# At least 32 characters. Generate with: openssl rand -hex 32
MERCHANT_API_KEY=change-me-to-32+-random-chars

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
CHECKOUT_TTL=15m
# 1000 USDC (6 decimals)
MAX_AMOUNT_BASE_UNITS=1000000000

# The relayer pays the gas for every transferWithAuthorization. Encrypted keystore
# (e.g. from `cast wallet new ~/.foundry/keystores crypto-pos-relayer`) plus a file
# holding its password. Keep both outside the repo. Fund with ~0.05 Sepolia ETH
# (and Base Sepolia ETH / Amoy POL for those networks). Same address on every chain.
RELAYER_KEYSTORE_PATH=/Users/you/.foundry/keystores/crypto-pos-relayer
RELAYER_PASSWORD_FILE=/Users/you/.foundry/crypto-pos-relayer.password
# Blocks a receipt must be buried under before a checkout is confirmed (Sepolia).
CONFIRMATIONS=1
